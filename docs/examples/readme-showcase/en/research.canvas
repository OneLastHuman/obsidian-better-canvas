    {
      "id": "source",
      "type": "text",
      "x": 0,
      "y": 165,
      "width": 330,
      "height": 435,
      "text": "# Reading material\n\nWhat context does a note worth keeping need?\n\n**Observation notes · Sample material**\n\nKeeping only the excerpt often erases why you marked it. Record the question and the source so you can reuse it in your writing.",
      "bcAutoResize": false,
      "bcResearchPreset": "source",
      "color": "#a84e34",
      "bcResearchIntensity": 26,
      "bcTextAlign": "left",
      "bcShape": "square",
      "bcBorderStyle": "solid",
      "styleAttributes": {
        "shape": "rectangle",
        "border": "solid",
        "textAlign": "left"
      }
    },
    {
      "id": "quote",
      "type": "text",
      "x": 435,
      "y": 165,
      "width": 330,
      "height": 315,
      "text": "> Keep the sentence, and the question you had.\n\nExcerpted from the sample material on the left.",
      "bcAutoResize": false,
      "bcResearchPreset": "quote",
      "color": "#b48a28",
      "bcResearchIntensity": 26,
      "bcTextAlign": "left",
      "bcShape": "square",
      "bcBorderStyle": "solid",
      "styleAttributes": {
        "shape": "rectangle",
        "border": "solid",
        "textAlign": "left"
      }
    },
    {
      "id": "annotation",
      "type": "text",
      "x": 435,
      "y": 495,
      "width": 330,
      "height": 220,
      "text": "## My annotation\n\nThe excerpt keeps the original words.\nThe annotation records your understanding.",
      "bcAutoResize": false,
      "bcResearchPreset": "annotation",
      "color": "#416879",
      "bcResearchIntensity": 26,
      "bcTextAlign": "left",
      "bcShape": "square",
      "bcBorderStyle": "solid",
      "styleAttributes": {
        "shape": "rectangle",
        "border": "solid",
        "textAlign": "left"
      }
    },
    {
      "id": "argument",
      "type": "text",
      "x": 875,
      "y": 165,
      "width": 355,
      "height": 390,
      "text": "# Let the claim return to its source\n\nRecord evidence and interpretation separately.\nConnect them to show the relationship.\n\n**Writing starts with relationships.**",
      "bcAutoResize": false,
      "bcResearchPreset": "argument",
      "color": "#63734a",
      "bcResearchIntensity": 26,
      "bcTextAlign": "left",
      "bcShape": "square",
      "bcBorderStyle": "solid",
      "styleAttributes": {
        "shape": "rectangle",
        "border": "solid",
        "textAlign": "left"
      }
    },
    {
      "id": "question",
      "type": "text",
      "x": 875,
      "y": 590,
      "width": 355,
      "height": 215,
      "text": "## Keep asking\n\nWhich evidence would change this judgment?",
      "bcAutoResize": false,
      "bcResearchPreset": "question",
      "bcBorderStyle": "dashed",
      "color": "#63734a",
      "bcResearchIntensity": 26,
      "bcTextAlign": "left",
