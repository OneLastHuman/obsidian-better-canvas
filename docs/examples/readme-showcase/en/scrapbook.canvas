      "width": 320,
      "height": 260,
      "text": "## Take-along list\n\n- [x] One short book\n- [x] Pencil and sticky notes\n- [ ] One excerpt to share",
      "bcAutoResize": false,
      "bcScrapbookPreset": "lined",
      "color": "#91a17c"
    },
    {
      "id": "quote",
