      "width": 320,
      "height": 310,
      "text": "## This week's idea\n\nHold the reading circle by the window.\n\nEveryone brings a book they are reading\nand starts from a line they love.",
      "bcAutoResize": false,
      "bcScrapbookPreset": "tape",
      "color": "#bd9455"
    },
    {
      "id": "list",
      "type": "text",
