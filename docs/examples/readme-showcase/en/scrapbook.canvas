      "width": 320,
      "height": 300,
      "text": "## Today's excerpt\n\nRead a little slower,\nleave some room\nfor your own questions.\n\n*Sample note*",
      "bcAutoResize": false,
      "bcScrapbookPreset": "torn",
      "color": "#bf826c"
    },
